<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dazzle · Donuts</title>
<style>
:root{--pink:#f0448b;--hot:#bd2865;--dark:#29152f;--cream:#fff9f4;--muted:#756879;--yellow:#ffd34d}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--dark);font-family:system-ui,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0}nav{padding:18px 7%;display:flex;justify-content:space-between;align-items:center;background:#ffe2ee}.brand{font-size:25px;font-weight:950}.edit{padding:11px 17px;border-radius:99px;background:#fff;font-weight:800}.top{background:var(--dark);color:#fff;text-align:center;padding:10px;font-size:13px}.top b{color:var(--yellow)}.hero{min-height:510px;padding:80px 8%;display:flex;align-items:center;justify-content:space-between;gap:30px;background:linear-gradient(120deg,#ffe1ee,#fff3c9,#e5f7ff)}.hero h1{font-size:clamp(52px,8vw,105px);line-height:.82;letter-spacing:-.09em;margin:18px 0}.hero h1 span{color:var(--pink)}.hero p{max-width:540px;color:var(--muted);font-size:18px;line-height:1.6}.donut{font-size:145px;padding:60px;border-radius:50%;background:#fff;box-shadow:18px 24px #ffffff88;animation:float 4s infinite ease-in-out}@keyframes float{50%{transform:translateY(-14px) rotate(4deg)}}.section{padding:72px 8%}.section h2{font-size:clamp(38px,5vw,70px);line-height:.9;letter-spacing:-.07em}.muted{color:var(--muted);line-height:1.6}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.card{padding:18px;border-radius:24px;background:var(--bg);min-height:275px}.photo{height:140px;display:grid;place-items:center;font-size:78px}.photo img{width:100%;height:140px;object-fit:cover;border-radius:14px}.card h3{margin:12px 0 5px}.card p{color:var(--muted);font-size:14px}.price{float:right;font-weight:900}.tag{font-size:11px;font-weight:900;text-transform:uppercase;background:#ffffffaa;padding:6px 9px;border-radius:99px}.rules{background:#fff0f7}.notice{padding:20px;border:3px solid var(--pink);border-radius:17px;background:#fff;color:var(--hot);line-height:1.55;margin-bottom:24px}.order{max-width:850px;background:#fff;padding:28px;border-radius:22px;box-shadow:0 15px 40px #0001}label{display:block;font-size:13px;font-weight:800;margin:14px 0 6px}input,textarea,select{width:100%;padding:12px;border:1px solid #e6d8e2;border-radius:10px;background:#fffafc}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.btn{padding:13px 18px;border-radius:99px;font-weight:900;background:var(--pink);color:#fff}.secondary{background:#f6e9ef;color:var(--hot)}.flavors{border:1px solid #eadde7;border-radius:14px;overflow:hidden}.flavor{display:grid;grid-template-columns:55px 1fr 85px 85px;gap:10px;align-items:center;padding:10px 12px;border-bottom:1px solid #eee}.flavor:last-child{border-bottom:0}.flavor img{width:50px;height:45px;object-fit:cover;border-radius:8px}.flavor input{padding:9px}.total{display:flex;justify-content:space-between;background:#fff0f7;padding:15px;border-radius:12px;margin-top:16px;font-weight:900}.receipt{display:none;margin-top:22px;padding:24px;background:#fff;border:1px solid #eadde7;border-radius:15px;line-height:1.55}.receipt h3{color:var(--hot);margin-top:0}.receipt table{width:100%;border-collapse:collapse;margin-top:14px}.receipt th,.receipt td{padding:7px;border-bottom:1px solid #eee;text-align:left}.receipt-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.qr{display:block;width:190px;height:190px;margin:15px auto}.order-view{display:none;background:#fff0f7;border:3px solid var(--pink);padding:25px;border-radius:20px;margin:35px 8%}.order-view.show{display:block}.order-view h2{margin-top:0;color:var(--hot)}.footer{padding:25px 8%;background:#efe5eb;color:var(--muted)}
#editorOverlay{display:none;position:fixed;inset:0;z-index:20;background:#21152fcc;align-items:center;justify-content:center;padding:15px}#editorOverlay.open{display:flex}.panel{width:min(850px,100%);max-height:94vh;overflow:auto;background:#fff;border-radius:22px;padding:26px}.panel-head{display:flex;justify-content:space-between;align-items:center}.close{width:38px;height:38px;border-radius:50%;background:#f3e8ef;font-size:20px}.hidden{display:none!important}.login{display:flex;gap:10px;margin:18px 0}.login input{flex:1}.status{min-height:22px;color:var(--hot);font-weight:800;font-size:13px}.help{color:var(--muted);font-size:12px;line-height:1.5}.box{border-top:1px solid #eee;margin-top:20px;padding-top:18px}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.full{grid-column:1/-1}.edit-row{display:grid;grid-template-columns:1fr 65px 1.2fr 35px;gap:7px;margin:8px 0}.edit-row input{padding:9px}.del{background:#ffe0ec;color:var(--hot);border-radius:8px}.add{padding:10px 13px;background:#e4faf2;color:#16866c;border-radius:8px;font-weight:800}.save{width:100%;margin-top:20px}.daily{display:grid;grid-template-columns:1fr auto;gap:10px}.daily-list{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:12px}.daily-list label{margin:0;padding:9px;border:1px solid #e6d8e2;border-radius:8px}.daily-list input{width:auto}@media(max-width:800px){.hero{display:block}.donut{display:inline-block;margin-top:35px}.cards{grid-template-columns:repeat(2,1fr)}.flavor{grid-template-columns:48px 1fr 65px}.flavor input:last-child{grid-column:2/-1}}@media(max-width:520px){.cards,.edit-grid,.two,.daily-list{grid-template-columns:1fr}.full{grid-column:auto}.login{display:block}.login button{margin-top:8px}.flavor{grid-template-columns:45px 1fr 60px}}
@media print{body>*:not(#printArea){display:none!important}#printArea{display:block!important}.receipt-actions{display:none!important}}
#printArea{display:none}
</style>
</head>
<body>
<div class="top">✨ <b>Pedidos anticipados:</b> recogida de martes a sábado · antes de las 7:00 p. m. del día anterior ✨</div>
<nav><div class="brand">🍩 <span id="brand">Dazzle</span></div><button class="edit" id="openEditor" type="button">⚙ Editar página</button></nav>
<section class="hero"><div><small>Dazzle · Donuts</small><h1>Haz que tu día <span>destelle.</span></h1><p id="heroText">Donas coloridas, divertidas y deliciosas para compartir, regalar o darte un capricho.</p></div><div class="donut">🍩</div></section>
<div id="orderView" class="order-view"></div>
<section class="section"><h2>Las donas que habrá hoy.</h2><p class="muted">Disponibilidad actualizada desde el panel privado.</p><div id="todayCards" class="cards"></div></section>
<section class="section"><h2>Catálogo completo.</h2><p class="muted">En pedidos anticipados puedes combinar varios sabores.</p><div id="catalogCards" class="cards"></div></section>
<section class="section rules"><div class="notice"><b>⚠ REGLAS DE PEDIDOS ANTICIPADOS</b><br><strong>Recogida únicamente de martes a sábado.</strong><br>El pedido debe realizarse, pagarse y confirmarse antes de las 7:00 p. m. del día anterior.</div><div class="order"><h2>Arma tu pedido</h2><p class="muted">Elige una cantidad diferente de cada sabor.</p><form id="orderForm"><div class="two"><div><label>Nombre</label><input id="firstName" required></div><div><label>Apellido</label><input id="lastName" required></div></div><div class="two"><div><label>Número de contacto</label><input id="phone" type="tel" required></div><div><label>Fecha de recogida</label><input id="pickup" type="date" required><small id="dateMessage"></small></div></div><label>Sabores y cantidades</label><div id="flavorList" class="flavors"></div><div class="total"><span>Donas: <b id="unitTotal">0</b></span><span>Total: $<b id="moneyTotal">0</b></span></div><button class="btn" type="submit" style="margin-top:18px">Generar recibo, QR y enviar pedido</button></form><div id="receipt" class="receipt"></div></div></section>
<section class="section"><h2>Ven por tu brillo.</h2><p><b id="address">Tu dirección aparecerá aquí</b><br><span id="contact">Tu contacto aparecerá aquí</span></p></section><footer class="footer"><b id="footerName">Dazzle</b> · Donuts.</footer>
<div id="editorOverlay"><div class="panel"><div class="panel-head"><h2>Editar Dazzle</h2><button class="close" id="closeEditor" type="button">×</button></div><div id="loginBox"><p>Introduce tu contraseña para editar.</p><div class="login"><input id="password" type="password" placeholder="Contraseña"><button class="btn" id="loginButton" type="button">Entrar</button></div><div id="loginStatus" class="status"></div><p class="help">Contraseña de demostración: <b>dazzle-admin</b></p></div><div id="editorBox" class="hidden"><div class="edit-grid"><div><label>Nombre</label><input id="editName"></div><div><label>Precio general</label><input id="editPrice" type="number"></div><div class="full"><label>Texto principal</label><textarea id="editHero" rows="2"></textarea></div><div><label>Dirección</label><input id="editAddress"></div><div><label>Teléfono</label><input id="editContact"></div></div><div class="box"><h3>Catálogo</h3><div id="editorFlavors"></div><button class="add" id="addFlavor" type="button">＋ Agregar dona</button></div><div class="box"><h3>Disponibilidad de hoy</h3><div class="daily"><div><label>Fecha</label><input id="dailyDate" type="date"></div><button class="add" id="loadDaily" type="button">Cargar día</button></div><div id="dailyList" class="daily-list"></div><p class="help">Todas las donas del catálogo aparecen aquí automáticamente.</p></div><button class="btn save" id="saveChanges" type="button">Guardar cambios</button><div id="saveStatus" class="status"></div></div></div></div>
<div id="printArea"></div>
<script>
var APPS_SCRIPT_URL='https://script.google.com/macros/s/AKfycbzz2v03AMHN5W-fP-m_RqprGKfhm9FurlkAb3vr1WKyRzXbQB-Cfg8yJ6VMzAMXXDgpow/exec';
var DEFAULT={name:'Dazzle',price:12,hero:'Donas coloridas, divertidas y deliciosas para compartir, regalar o darte un capricho.',address:'Tu dirección aparecerá aquí',contact:'Tu contacto aparecerá aquí',flavors:[{name:'Glaseado arcoíris',price:12,emoji:'🍩',tag:'Colorida',desc:'Color, alegría y chispitas.',bg:'#ffe0ec',photo:''},{name:'Oreo Galaxy',price:12,emoji:'🍪',tag:'Favorita',desc:'Chocolate y trocitos de Oreo.',bg:'#e9ddff',photo:''},{name:'Mapple Moon',price:12,emoji:'🍫',tag:'Dulce',desc:'Chocolate y glaseado.',bg:'#fff0bb',photo:''}],daily:{}};
var data=JSON.parse(localStorage.getItem('dazzleQROrders')||'null')||DEFAULT;function id(x){return document.getElementById(x)}function today(){return new Date().toISOString().slice(0,10)}function save(){localStorage.setItem('dazzleQROrders',JSON.stringify(data))}function validDay(s){var d=new Date(s+'T12:00:00').getDay();return d>=2&&d<=6}
function cards(list){var html='';list.forEach(function(f){html+='<article class="card" style="--bg:'+(f.bg||'#ffe0ec')+'"><span class="tag">'+(f.tag||'Sabor')+'</span><span class="price">$'+f.price+'</span><div class="photo">'+(f.photo?'<img src="'+f.photo+'">':(f.emoji||'🍩'))+'</div><h3>'+f.name+'</h3><p>'+f.desc+'</p></article>'});return html}
function render(){var active=data.daily[today()]||[];id('brand').textContent=data.name;id('footerName').textContent=data.name;id('heroText').textContent=data.hero;id('address').textContent=data.address;id('contact').textContent=data.contact;id('todayCards').innerHTML=cards(data.flavors.filter(function(f){return active.indexOf(f.name)>=0}));id('catalogCards').innerHTML=cards(data.flavors);renderFlavorList()}
function renderFlavorList(){var html='';data.flavors.forEach(function(f,i){html+='<div class="flavor"><div>'+(f.photo?'<img src="'+f.photo+'">':(f.emoji||'🍩'))+'</div><div><b>'+f.name+'</b><br><small>$'+f.price+'</small></div><label style="margin:0">Cantidad<input class="qty" data-index="'+i+'" type="number" min="0" value="0"></label><div class="line">$0</div></div>'});id('flavorList').innerHTML=html;document.querySelectorAll('.qty').forEach(function(input){input.oninput=updateTotals})}
function updateTotals(){var units=0,total=0;document.querySelectorAll('.qty').forEach(function(input){var q=Number(input.value)||0;var f=data.flavors[Number(input.dataset.index)];units+=q;total+=q*Number(f.price);var line=input.parentElement.parentElement.querySelector('.line');if(line)line.textContent='$'+q*Number(f.price)});id('unitTotal').textContent=units;id('moneyTotal').textContent=total}
function minDate(){var n=new Date(),d=new Date(n);d.setHours(0,0,0,0);d.setDate(d.getDate()+(n.getHours()>=19?2:1));while(!validDay(d.toISOString().slice(0,10)))d.setDate(d.getDate()+1);return d.toISOString().slice(0,10)}id('pickup').min=minDate();id('pickup').value=minDate();id('dateMessage').textContent='Solo martes a sábado.';id('dailyDate').value=today();render();
function encodeOrder(order){return btoa(unescape(encodeURIComponent(JSON.stringify(order)))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function showOrderFromQR(){var value=new URLSearchParams(location.search).get('pedido');if(!value)return;try{var order=JSON.parse(decodeURIComponent(escape(atob(value.replace(/-/g,'+').replace(/_/g,'/')))));var rows=order.items.map(function(item){return '<li>'+item.quantity+' × '+item.name+' — $'+item.quantity*item.unitPrice+'</li>'}).join('');id('orderView').innerHTML='<h2>Pedido '+order.id+'</h2><p><b>Cliente:</b> '+order.firstName+' '+order.lastName+'<br><b>Contacto:</b> '+order.phone+'<br><b>Realizado:</b> '+order.createdDate+' a las '+order.createdTime+'<br><b>Recogida:</b> '+order.pickupDate+'</p><h3>Donas solicitadas</h3><ul>'+rows+'</ul><h3>Total: $'+order.total+' pesos</h3>';id('orderView').classList.add('show')}catch(error){console.log('QR no válido')}}showOrderFromQR();
id('openEditor').onclick=function(){id('editorOverlay').classList.add('open')};id('closeEditor').onclick=function(){id('editorOverlay').classList.remove('open')};id('editorOverlay').onclick=function(e){if(e.target===id('editorOverlay'))id('editorOverlay').classList.remove('open')};id('pickup').onchange=function(){if(!validDay(this.value)){this.value='';id('dateMessage').textContent='⚠ Domingo y lunes no disponibles.'}};
id('orderForm').onsubmit=function(e){e.preventDefault();var date=id('pickup').value;if(!validDay(date)||new Date(date+'T12:00:00')<new Date(id('pickup').min+'T12:00:00')){alert('Selecciona una fecha de martes a sábado y respeta las 7:00 p. m. del día anterior.');return}var items=[],total=0;document.querySelectorAll('.qty').forEach(function(input){var q=Number(input.value)||0;if(q>0){var f=data.flavors[Number(input.dataset.index)];items.push({name:f.name,quantity:q,unitPrice:Number(f.price)});total+=q*Number(f.price)}});if(!items.length){alert('Selecciona al menos una dona.');return}var now=new Date();var order={id:'DZ-'+now.getTime().toString().slice(-8),createdDate:now.toLocaleDateString('es-MX'),createdTime:now.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'}),firstName:id('firstName').value,lastName:id('lastName').value,phone:id('phone').value,pickupDate:new Date(date+'T12:00:00').toLocaleDateString('es-MX',{weekday:'long',day:'numeric',month:'long',year:'numeric'}),items:items,total:total};var publicLink=location.href.split('?')[0]+'?pedido='+encodeOrder(order);var qr='https://api.qrserver.com/v1/create-qr-code/?size=220x220&data='+encodeURIComponent(publicLink);var rows=items.map(function(i){return '<tr><td>'+i.name+'</td><td>'+i.quantity+'</td><td>$'+i.quantity*i.unitPrice+'</td></tr>'}).join('');id('receipt').innerHTML='<h3>DAZZLE · RECIBO DE PEDIDO</h3><b>Pedido:</b> '+order.id+'<br><b>Cliente:</b> '+order.firstName+' '+order.lastName+'<br><b>Contacto:</b> '+order.phone+'<br><b>Realizado:</b> '+order.createdDate+' a las '+order.createdTime+'<br><b>Recogida:</b> '+order.pickupDate+'<table><tr><th>Sabor</th><th>Cantidad</th><th>Total</th></tr>'+rows+'</table><p><b>Total:</b> $'+order.total+' pesos</p><img class="qr" src="'+qr+'"><small style="display:block;text-align:center">Escanea este QR para abrir este pedido exacto.</small><div class="receipt-actions"><button class="btn" id="printReceipt" type="button">Imprimir / Guardar PDF</button></div>';id('receipt').style.display='block';id('printReceipt').onclick=function(){id('printArea').innerHTML='<div style="font-family:Arial;max-width:700px;margin:30px auto">'+id('receipt').innerHTML+'</div>';window.print()};
fetch(APPS_SCRIPT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(order)}).then(function(){console.log('Pedido enviado a Dazzle Pedidos')}).catch(function(error){console.log('No se pudo enviar el pedido',error)})};
function loadEditor(){id('editName').value=data.name;id('editPrice').value=data.price;id('editHero').value=data.hero;id('editAddress').value=data.address;id('editContact').value=data.contact;renderEditorFlavors()}function renderEditorFlavors(){var html='';data.flavors.forEach(function(f,i){html+='<div class="edit-row"><input data-i="'+i+'" data-k="name" value="'+f.name+'"><input data-i="'+i+'" data-k="price" type="number" value="'+f.price+'"><input data-i="'+i+'" data-k="desc" value="'+f.desc+'"><button class="del" data-del="'+i+'" type="button">×</button></div>'});id('editorFlavors').innerHTML=html;document.querySelectorAll('[data-del]').forEach(function(b){b.onclick=function(){data.flavors.splice(Number(b.dataset.del),1);renderEditorFlavors();render()}})}function loadDaily(){var date=id('dailyDate').value||today(),active=data.daily[date]||[];var html='';data.flavors.forEach(function(f){html+='<label><input data-day="'+f.name+'" type="checkbox" '+(active.indexOf(f.name)>=0?'checked':'')+'>'+(f.emoji||'🍩')+' '+f.name+'</label>'});id('dailyList').innerHTML=html;document.querySelectorAll('[data-day]').forEach(function(c){c.onchange=function(){data.daily[date]=Array.from(document.querySelectorAll('[data-day]:checked')).map(function(x){return x.dataset.day});save();render();loadDaily()}})}id('loadDaily').onclick=loadDaily;id('addFlavor').onclick=function(){data.flavors.push({name:'Nueva dona',price:data.price,emoji:'🍩',tag:'Nuevo',desc:'Describe este sabor.',bg:'#ffe0ec',photo:''});renderEditorFlavors();render()};id('loginButton').onclick=function(){if(id('password').value!=='dazzle-admin'){id('loginStatus').textContent='Contraseña incorrecta.';return}id('loginBox').classList.add('hidden');id('editorBox').classList.remove('hidden');loadEditor();loadDaily()};id('saveChanges').onclick=function(){data.name=id('editName').value||'Dazzle';data.price=Number(id('editPrice').value)||12;data.hero=id('editHero').value;data.address=id('editAddress').value;data.contact=id('editContact').value;document.querySelectorAll('#editorFlavors [data-i]').forEach(function(x){var i=Number(x.dataset.i);data.flavors[i][x.dataset.k]=x.dataset.k==='price'?(Number(x.value)||data.price):x.value});save();render();id('saveStatus').textContent='Cambios guardados ✓'};
</script></body>
</html>
